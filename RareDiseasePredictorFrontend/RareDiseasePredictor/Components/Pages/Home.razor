@page "/"
@using RareDiseasePredictor.Models
@using System.Text.Json
@inject ILogger<Home> Logger
@rendermode InteractiveServer
@inject ApiDiseaseData diseaseData
@inject HttpClient Http
@using static System.Net.WebRequestMethods
<PageTitle>Home</PageTitle>


<h1>Rare Disease Finder</h1>
<div class="d-flex flex-column align-items-center">
    @if (diseaseData.symptoms is not null)
    {
        
        <div class="mb-3">
        <label class="form-label fs-6">Symptom Selector</label>
        <select class="form-select" @bind="selectedSymptomName">
                <option value="" disabled selected>-- Select a Symptom --</option>
            @foreach (var symptom in diseaseData.symptoms)
                {
                    <option value="@symptom.Name">@symptom.Name</option>
                }
        </select>
        </div>
    

    


        @if (selectedSymptom is not null && selectedSymptom.Regions is not null)
        {
    

            <div class="mb-3">
                <label class="form-label fs-6">Add Region</label>                
                <select class="form-select" @bind="selectedRegionName">
                    <option value="" disabled selected>-- Select a Region --</option>
                    @foreach (var region in selectedSymptom.Regions)
                    {
                        <option value="@region.Name">@region.Name</option>
                    }
                </select>
                
            </div>
        }

        <button type="button" class="btn btn-secondary mt-3" @onclick="AddSymptom">Add symptom and region</button>


        @if (Symptoms.Count() != 0)
        {
            <label class="form-label mb-3 fs-6">Symptoms</label>
        

        <div class="mb-3">
            @for (int i = 0; i < Symptoms.Count(); i++)
            {
                    @*Need to fix this so the spacing is more correct*@
                    int b = i;
                    <div class="row">
                    <div class="col-md-2"><button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoveSymptom(b)">X</button></div>
                    <div class="col col fs-5"><p>@Symptoms[i].Item1.Name</p></div>
                    <div class="col col fs-5"><p>@Symptoms[i].Item2.Name</p></div>
                </div>
            }
        </div>
        }
    }
</div>



@code {

    private Symptom selectedSymptom => diseaseData.symptoms?.FirstOrDefault(f => f.Name == selectedSymptomName);
    private string selectedSymptomName;

    private Region selectedRegion => selectedSymptom.Regions.FirstOrDefault(f => f.Name == selectedRegionName);
    private string selectedRegionName;

    private List<(Symptom, Region)> Symptoms = new();


    protected override async void OnInitialized()
    {
        if (diseaseData.symptoms is null)
        {
            try
            {
                await diseaseData.LoadSymptomsData(Http, "https://localhost:57693/symptoms");
                Logger.LogInformation("Sucessfully got API info for symptoms");

            }
            catch (Exception ex)
            {
                Logger.LogError(" Error attempting to get Symptoms: " + ex.Message);
            }
        }
    }

    private void AddSymptom()
    {
        Symptoms.Add((selectedSymptom, selectedRegion));
    }

    private void RemoveSymptom (int i)
    {
        Symptoms.RemoveAt(i);
    }

