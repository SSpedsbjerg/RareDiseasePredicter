@page "/admin"
@using RareDiseasePredictor.Models
@using RareDiseasePredictor.Components.Pages.Modals
@using System.Text.Json
@using static System.Net.WebRequestMethods
@inject ILogger<Admin> Logger
@rendermode InteractiveServer

<h1>Admin Control Board</h1>

<PageTitle>Admin Board</PageTitle>


<button type="button" class="btn btn-success" @onclick="ShowAddDiseaseModal">Add Disease</button>
<button type="button" class="btn btn-warning" @onclick="ShowEditDiseaseModal">Edit Disease</button>



<ModalAddDisease @ref="modalAddDisease" IsVisible="false" />
<ModalEditDisease @ref="modalEditDisease" IsVisible="false" />


@code {

    private ModalAddDisease modalAddDisease = new ModalAddDisease();
    private ModalEditDisease modalEditDisease = new ModalEditDisease();


    private void ShowAddDiseaseModal()
    {
        Logger.LogInformation("Attempting to open Add Disease modal...");
        modalAddDisease.Show();
        StateHasChanged();
    }

    private void ShowEditDiseaseModal()
    {
        Logger.LogInformation("Attempting to open Edit Disease modal...");
        modalEditDisease.Show();
        StateHasChanged();
    }
}
