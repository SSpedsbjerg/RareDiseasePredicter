@page "/admin"
@using RareDiseasePredictor.Models
@using RareDiseasePredictor.Components.Pages.Modals
@using System.Text.Json
@using static System.Net.WebRequestMethods
@inject ILogger<Admin> Logger
@inject HttpClient Http
@inject ApiDiseaseData diseaseData
@rendermode InteractiveServer

<h1>Admin Control Board</h1>

<PageTitle>Admin Board</PageTitle>



    <button type="button" class="btn btn-success" @onclick="ShowAddDiseaseModal">Add Disease</button>
    <button type="button" class="btn btn-warning" @onclick="ShowEditDiseaseModal">Edit Disease</button>
    <ModalAddDisease @ref="modalAddDisease" IsVisible="false"/>
    <ModalEditDisease @ref="modalEditDisease" IsVisible="false"/>




@code {

    private ModalAddDisease modalAddDisease = new ModalAddDisease();
    private ModalEditDisease modalEditDisease = new ModalEditDisease();
    private List<Symptom> symptoms;
    private List<Disease> diseases;
    private string currentModal;

    //TODO: Ændre hardcodet string tekst til et parent object med Modals og et navn
    private void ShowAddDiseaseModal()
    {
        Logger.LogInformation("Attempting to open Add Disease modal...");
        if (currentModal != "adddiseasemodal" && currentModal is not null)
        {
            modalCloser(currentModal);
        }
        modalAddDisease.Show();
        currentModal = "adddiseasemodal";
        StateHasChanged();
    }

    private void ShowEditDiseaseModal()
    {
        Logger.LogInformation("Attempting to open Edit Disease modal...");
        if (currentModal != "editdiseasemodal" && currentModal is not null)
        {
            modalCloser(currentModal);
        }
        modalEditDisease.Show();
        currentModal = "editdiseasemodal";
        StateHasChanged();
    }

    private void modalCloser(string currentModal)
    {
        switch (currentModal)
        {
            case "editdiseasemodal":
                modalEditDisease.Close();
                break;
            case "adddiseasemodal":
                modalAddDisease.Close();
                break;
        }

            
    }

    protected override async Task OnInitializedAsync()
    {

        if(diseaseData.symptoms is null)
        {
            try
            {
                await diseaseData.LoadSymptomsData(Http, "https://localhost:57693/symptoms");
                Logger.LogInformation("Sucessfully got API info for symptoms");

            }
            catch (Exception ex)
            {
                Logger.LogError(" Error attempting to get Symptoms: " + ex.Message);
            }
        }

        if(diseaseData.diseases is null)
        {
            try
            {
                await diseaseData.LoadDiseaseData(Http, "https://localhost:57693/diseases");
                Logger.LogInformation("Sucessfully got API info for diseases");
            }
            catch (Exception ex)
            {
                Logger.LogError(" Error attempting to get Diseases: " + ex.Message);
            }

        }

        
    }
}
