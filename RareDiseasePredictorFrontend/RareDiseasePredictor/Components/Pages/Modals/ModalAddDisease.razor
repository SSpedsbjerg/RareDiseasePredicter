@rendermode InteractiveServer
@inject ILogger<ModalAddDisease> Logger
@using RareDiseasePredictor.Models
@using System.Text.Json
@using static System.Net.WebRequestMethods
@inject HttpClient Http
@inject ApiDiseaseData diseaseData


<div class="modal-dialog modal-dialog-centered p-3 @(IsVisible ? "d-block" : "d-none")" data-bs-autohide="true" data-bs-delay="5000">
    <div class="modal-dialog-centered">

        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5">Add disease</h1>
                <button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
            </div>
            <div class="modal-body">
                @if (diseaseData.symptoms is null)
                {
                    <p>Loading...</p>
                }
                else
                {
                    <div>
                        <EditForm Model="@disease" OnValidSubmit="@AddDisease">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="mb-3">
                                <label class="form-label fs-6">Disease Name</label>
                                <InputText id="Name" class="form-control" placeholder="Name" @bind-Value="disease.Name" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fs-6">Disease Description</label>
                                <InputText id="Description" class="form-control" placeholder="Description" @bind-Value="disease.Description" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fs-6">Disease Href</label>
                                <InputText id="Href" class="form-control" placeholder="Href" @bind-Value="disease.Href" />
                            </div>
                            <div>
                                @if (disease.Symptoms.Count() != 0)
                                {
                                    <label class="form-label mb-3 fs-6">Symptomer</label>
                                }

                                <div class="mb-3">
                                    @for (int i = 0; i < disease.Symptoms.Count; i++)
                                    {
                                        int b = i;
                                        <div class="row">
                                            <div class="col-md-2"><button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoveSymptom(b)">X</button></div>
                                            <div class="col col fs-5"><p>@disease.Symptoms[i].Name</p></div>
                                        </div>
                                    }
                                </div>




                                <div class="mb-3">
                                    <InputText @bind-Value="newSymptom" class="form-control" placeholder="Add new symptom" list="symptomdatalist" />
                                    <datalist id="symptomdatalist">
                                        @foreach (var symptom in diseaseData.symptoms)
                                        {
                                            <option value="@symptom.Name">@symptom.Name</option>
                                        }
                                    </datalist>
                                    <button type="button" class="btn btn-secondary mt-3" @onclick="AddSymptom">Add Symptom</button>
                                </div>
                            </div>


                            <button type="submit" class="btn btn-primary mb-3">Add Disease</button>
                        </EditForm>
                    </div>
                }
            </div>
        </div>
    </div>
</div>


@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }
 
    public void Show()
    {
        Logger.LogInformation("Attempting to Show Add Disease Modal...");
        IsVisible = true;
        StateHasChanged();
    }

    public void Close()
    {
        Logger.LogInformation("Attempting to Close Modal...");
        IsVisible = false;
        if (OnClose.HasDelegate)
        {
            OnClose.InvokeAsync();
        }
        StateHasChanged();
    }


    private Disease disease = new Disease();

    private string newSymptom = string.Empty;

    private void AddSymptom()
    {
        Logger.LogInformation("Attempting to add symptom");
        if (!string.IsNullOrWhiteSpace(newSymptom))
        {
            var symptom = diseaseData.symptoms.FirstOrDefault(symp => symp.Name == newSymptom);

            if (symptom != null)
            {
                disease.Symptoms.Add(symptom);
                newSymptom = string.Empty;
            }

        }
    }

    private void RemoveSymptom(int index)
    {
        Logger.LogWarning("Index Value: " + index.ToString());
        Logger.LogWarning("Amount of symptoms: " + disease.Symptoms.Count().ToString());
        disease.Symptoms.RemoveAt(index);

    }


    private async Task AddDisease()
    {
        var jsonString = JsonSerializer.Serialize(disease, new JsonSerializerOptions { WriteIndented = true });
        Logger.LogInformation("Json File: " + jsonString);
        var httpClient = new HttpClient();
        var response = await httpClient.PostAsJsonAsync("https://localhost:57693/AddDisease/", disease);

        if (response.IsSuccessStatusCode)
        {
            Logger.LogInformation("Sucessfully added disease");
        }
        else
        {
            Logger.LogError("Error trying to post data: " + response.StatusCode);
        }

    }

    

}
