@rendermode InteractiveServer
@inject ILogger<ModalAddDisease> Logger
@using RareDiseasePredictor.Models
@using System.Text.Json
@using System.Net.Http.Headers
@using static System.Net.WebRequestMethods
@inject HttpClient Http
@inject ApiDiseaseData diseaseData
@inject Authentication.HoldTheToken http

<div class="modal-dialog modal-dialog-centered p-3 @(IsVisible ? "d-block" : "d-none")" data-bs-autohide="true" data-bs-delay="5000">
    <div class="modal-dialog-centered">

        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5">Add Region</h1>
                <button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
            </div>
            <div class="modal-body">
                    <div>
                        <EditForm Model="@region" OnValidSubmit="@AddRegion">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="mb-3">
                                <label class="form-label fs-6">Region Name</label>
                                <InputText id="Name" class="form-control" placeholder="Name" @bind-Value="region.Name" />
                            </div>


                            <button type="submit" class="btn btn-primary mb-3">Add Region</button>
                        </EditForm>
                    </div>
            </div>
        </div>
    </div>
</div>


@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    public void Show()
    {
        Logger.LogInformation("Attempting to Show Add Disease Modal...");
        IsVisible = true;
        StateHasChanged();
    }

    public void Close()
    {
        Logger.LogInformation("Attempting to Close Modal...");
        IsVisible = false;
        if (OnClose.HasDelegate)
        {
            OnClose.InvokeAsync();
        }
        StateHasChanged();
    }


    private Region region = new Region();



    private async Task AddRegion()
    {
        var jsonString = JsonSerializer.Serialize(region, new JsonSerializerOptions { WriteIndented = true });
        Logger.LogInformation("Json File: " + jsonString);


        var httpClient = http.GetHttpClient();

        var response = await httpClient.PostAsJsonAsync("https://localhost:57693/Region/", region);

        if (response.IsSuccessStatusCode)
        {
            Logger.LogInformation("Sucessfully added Region");
        }
        else
        {
            Logger.LogError("Error trying to post data: " + response.StatusCode);
        }

    }

    

}
