@page "/login"
@inject HttpClient Http;
@inject HoldTheToken holder;
@inject NavigationManager Navigation;
@inject ILogger<Login> Logger
@using Microsoft.AspNetCore.Components.Authorization
@using RareDiseasePredictor.Components.Authentication
@using System.Text.Json
@rendermode InteractiveServer
<h3>Login</h3>

<EditForm Model="@loginModel" OnValidSubmit="@HandleLogin" FormName="loginForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3 col-2">
        <label class="form-label fs-6">Username:</label>
        <InputText id="Username" class="form-control" placeholder="Username" @bind-Value="loginModel.Username" />
    </div>

    <div class="mb-3 col-2">
        <label class="form-label fs-6">Password:</label>
        <InputText id="Password" class="form-control" placeholder="Password" @bind-Value="loginModel.Password" type="password" />
    </div>

    <button type="submit" class="btn btn-info mb-3">Login</button>
</EditForm>
<a href="https://localhost:7028/register">No Account?, Click here to register!</a>

@code {
    private LoginModel loginModel = new();

    private async Task HandleLogin()
    {
        var response = await Http.PostAsJsonAsync("https://localhost:57693/login/", loginModel);
        if (response.IsSuccessStatusCode)
        {
            var token = await response.Content.ReadAsStringAsync();
            var fulltoken = JsonSerializer.Deserialize<string>(token);
            Logger.LogInformation("Got token value of: " + fulltoken);
            // Store the token in a singelton
            holder.setToken(fulltoken);

            // Navigate to the home page or an authorized page
            Navigation.NavigateTo("/");
        }
        else
        {
            Logger.LogError("Error attempting to login: " + response.StatusCode + response.Content);
        }
    }

    public class LoginModel
    {
        public string Username { get; set; }
        public string Password { get; set; }
    }
}
